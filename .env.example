# Copy this file to .env and fill in your values.

# Required — powers the chat/generation step via Groq's fast inference API.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Any current Groq-hosted chat model works, e.g. llama-3.3-70b-versatile
# or llama-3.1-8b-instant for lower latency. Check https://console.groq.com/docs/models
CHAT_MODEL=llama-3.3-70b-versatile

# Groq has no embeddings endpoint, so embeddings default to a free local
# HuggingFace model ("huggingface"). Set to "openai" only if you also
# provide OPENAI_API_KEY below and prefer OpenAI embeddings instead.
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=hf_..
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional — only used if EMBEDDING_PROVIDER=openai above.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
SIMILARITY_SCORE_THRESHOLD=0.75
